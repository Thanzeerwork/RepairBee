          "request": { "method": "GET", "url": { "raw": "{{base_url}}/users?page=1&limit=20&role=customer", "host": ["{{base_url}}"], "path": ["users"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }, { "key": "role", "value": "customer" }] }, "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }] }
