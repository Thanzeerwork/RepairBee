  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"Test@1234\",\n  \"phone\": \"+919876543210\",\n  \"role\": \"customer\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json();", "if (json.data) {", "  pm.collectionVariables.set('access_token', json.data.accessToken);", "}"] } }]
        },
        {
          "name": "Register Shop Owner",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Shop Owner\",\n  \"email\": \"shop@example.com\",\n  \"password\": \"Shop@1234\",\n  \"phone\": \"+919123456789\",\n  \"role\": \"shop_owner\"\n}" }
